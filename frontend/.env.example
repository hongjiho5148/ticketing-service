# reCAPTCHA v2 사이트 키(공개). 비어 있으면 캡차 위젯이 없다. 서버의 RECAPTCHA_SECRET_KEY와 짝이어야 한다.
VITE_RECAPTCHA_SITE_KEY=

# Shown on the 문의하기 page; leave empty to show a placeholder address
