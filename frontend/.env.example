VITE_API_BASE_URL=http://localhost:8080/api
VITE_BACKEND_ORIGIN=http://localhost:8080
VITE_PORTONE_STORE_ID=
VITE_PORTONE_CHANNEL_KEY=
# Optional easy-pay channels - each one is its own channel in the PortOne console (test channel
# keys work without a merchant contract). A method with no key here simply isn't offered at checkout.
VITE_PORTONE_CHANNEL_KEY_KAKAOPAY=
VITE_PORTONE_CHANNEL_KEY_NAVERPAY=
# reCAPTCHA v2 site key (public). Empty = no captcha widget; must be paired with RECAPTCHA_SECRET_KEY on the server.
VITE_RECAPTCHA_SITE_KEY=

# Shown on the 문의하기 page; leave empty to show a placeholder address
VITE_CONTACT_EMAIL=
