GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 인증, 공연 알림, QR 티켓, 오픈/취소표 알림 메일을 보내는 Gmail SMTP (Gmail 주소와 앱 비밀번호이며 로그인 비밀번호가 아니다)
MAIL_USERNAME=
MAIL_PASSWORD=

# PortOne(테스트/샌드박스) 결제 연동
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# 서명용 시크릿 - 필수이며 기본값이 없다. 소스에 박아 둔 시크릿은 모두가 가진 시크릿이므로 이것이 없으면
# 서비스가 시작을 거부한다. 최소 32바이트의 무작위 값을 쓴다.
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# auth-service(서명)와 다른 모든 서비스(검증)가 함께 쓰므로 반드시 같아야 한다.
JWT_SECRET=
# 입구에서 보여 주는 QR 코드를 서명한다(order-service만 쓴다). JWT_SECRET과는 다르게 둔다. 로그인 시크릿이
# 유출돼도 티켓을 위조할 수 없고, 그 반대도 마찬가지다.
QR_TOKEN_SECRET=

# 선택: 한 사용자가 공연당 잡거나 가질 수 있는 최대 좌석 수(기본 4).
# RESERVATION_MAX_SEATS_PER_EVENT=4

# KOPIS (공연예술통합전산망) open API service key - https://www.kopis.or.kr/por/cs/openapi/openApiInfo.do
# Needed only by the admin "공연 가져오기" import; leave empty to disable it.
KOPIS_SERVICE_KEY=

# reCAPTCHA v2 ("로봇이 아닙니다" 체크박스) - https://www.google.com/recaptcha/admin
# 시크릿은 여기에 두고, 짝이 되는 사이트 키는 frontend/.env의 VITE_RECAPTCHA_SITE_KEY에 넣는다.
# 비워 두면 캡차 없이 실행된다.
RECAPTCHA_SECRET_KEY=

# Grafana 관리자 비밀번호(모니터링 대시보드는 http://localhost:3030이며 이 PC에서만 열린다).
# 익명 방문자는 볼 수만 있다. 기본값 'admin'은 로컬 개발용이므로 PC를 같이 쓴다면 직접 정한다.
# GRAFANA_ADMIN_PASSWORD=
