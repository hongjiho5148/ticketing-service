GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# Gmail SMTP for verification, show-reminder, QR-ticket and open/waitlist alert emails (Gmail address + App Password, not your login password)
MAIL_USERNAME=
MAIL_PASSWORD=

# PortOne (test/sandbox) payment integration
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# Signing secrets - REQUIRED, there is no default: the services refuse to start without them, because a
# secret baked into the source is a secret everyone has. Use random values of at least 32 bytes:
#   openssl rand -base64 48
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Shared between auth-service (signs) and every other service (verifies) - must be identical.
JWT_SECRET=
# Signs the QR codes shown at the gate (order-service only). Keep it different from JWT_SECRET, so a
# leaked login secret can't forge tickets and the other way round.
QR_TOKEN_SECRET=

# Optional: most seats one user may hold or own per event (default 4).
# RESERVATION_MAX_SEATS_PER_EVENT=4

# KOPIS (공연예술통합전산망) open API service key - https://www.kopis.or.kr/por/cs/openapi/openApiInfo.do
# Needed only by the admin "공연 가져오기" import; leave empty to disable it.
KOPIS_SERVICE_KEY=

# reCAPTCHA v2 ("I'm not a robot" checkbox) - https://www.google.com/recaptcha/admin
# The secret stays here; the matching site key goes in frontend/.env as VITE_RECAPTCHA_SITE_KEY.
# Leave it empty to run without captcha.
RECAPTCHA_SECRET_KEY=
